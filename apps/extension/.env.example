# All extension settings are public. Never put API keys or auth secrets here.
# Local builds default to http://localhost:3001.
# Put deployment settings in .env.production.local or CI.
WXT_PREP_SHEET_ORIGIN=https://your-prep-sheet-domain.example
# Base64 DER public key from the relevant store listing, for stable release IDs.
WXT_EXTENSION_PUBLIC_KEY=
